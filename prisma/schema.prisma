generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum NotificationType {
  ANNOUNCEMENT
  WEATHER
  DISASTER
  CONGESTION
  CLOSED
}

enum TransportMode {
  WALK
  TRAIN
  BUS
  BICYCLE
  CAR
  MIXED
}

enum RouteCondition {
  FASTEST
  SHORTEST
  CHEAPEST
  LESS_WALKING
  FEWER_TRANSFERS
  AVOID_CROWDS
}

enum SpotPopularity {
  LOCAL_FAVORITE
  MAJOR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  favorites     Favorite[]
  savedRoutes   SavedRoute[]
  searchHistory SearchHistory[]
  auditLogs     AuditLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SavedRoute {
  id          String          @id @default(cuid())
  userId      String
  title       String
  origin      String
  destination String
  mode        TransportMode
  condition   RouteCondition   @default(FASTEST)
  details     Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Region {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  spots     Spot[]
}

model Spot {
  id            String     @id @default(cuid())
  regionId      String
  slug          String
  name          String
  description   String?    @db.Text
  category      String
  popularity   SpotPopularity @default(MAJOR)
  categoryId    String?
  address       String?
  latitude      Decimal    @db.Decimal(10, 7)
  longitude     Decimal    @db.Decimal(10, 7)
  location      Unsupported("geography(Point, 4326)")?
  isPublished   Boolean    @default(false)
  openingHours  Json?
  priceInfo     Json?
  instagramUrl  String?
  xUrl          String?
  officialUrl   String?
  region        Region     @relation(fields: [regionId], references: [id], onDelete: Restrict)
  categoryRef   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  favorites     Favorite[]
  translations  SpotTranslation[]
  images        SpotImage[]
  statusOverride SpotStatusOverride?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([regionId, slug])
  @@index([regionId, category])
  @@index([categoryId])
  @@index([isPublished])
}

model SpotStatusOverride {
  id                    String   @id @default(cuid())
  spotId                String   @unique
  isTemporarilyClosed   Boolean  @default(false)
  congestionLevel       Int      @default(1)
  noticeMessage         String?  @db.Text
  updatedAt             DateTime @updatedAt

  spot Spot @relation(fields: [spotId], references: [id], onDelete: Cascade)
}

model SpotTranslation {
  id          String   @id @default(cuid())
  spotId      String
  language    String
  name        String
  description String?  @db.Text
  spot        Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@unique([spotId, language])
  @@index([language])
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  translations CategoryTranslation[]
  spots        Spot[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  language   String
  name       String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, language])
  @@index([language])
}

model SpotImage {
  id        String   @id @default(cuid())
  spotId    String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@index([spotId, sortOrder])
}

model Favorite {
  userId    String
  spotId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@id([userId, spotId])
  @@index([spotId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model Notification {
  id            String                    @id @default(cuid())
  sourceId      String?                   @unique
  type          NotificationType          @default(ANNOUNCEMENT)
  isGlobal      Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  translations NotificationTranslation[]
}

model NotificationTranslation {
  id             String       @id @default(cuid())
  notificationId String
  language       String
  title          String
  content        String       @db.Text
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, language])
  @@index([language])
}
